{
  "dialect": "British",
  "dictionary": "checks/harper-dictionary.txt",
  "paths": [
    "content/*.typ",
    "scripts/*.py",
    "*.md"
  ],
  "ignore": [
    "AnA",
    "AvoidAndAlso",
    "AvoidCurses",
    "CapitalizePersonalPronouns",
    "CondenseAllThe",
    "DiscourseMarkers",
    "DisjointPrefixes",
    "EllipsisLength",
    "Excellent",
    "LeftRightHand",
    "LongSentences",
    "MassNouns",
    "MissingPreposition",
    "OrthographicConsistency",
    "Overall",
    "OxfordComma",
    "SentenceCapitalization",
    "SplitWords",
    "UnclosedQuotes",
    "UseTitleCase"
  ],
  "harper": {
    "version": "2.11.0",
    "linux_x86_64": {
      "url": "https://github.com/Automattic/harper/releases/download/v2.11.0/harper-cli-x86_64-unknown-linux-gnu.tar.gz",
      "sha256": "1bfbe16927ef86b8ae09a964f83ea0662bca023f3ad32a5dc0dd141d5e684cd9"
    }
  }
}
